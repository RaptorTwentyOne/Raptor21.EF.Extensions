# Normalise to LF in the repository. CI runs on Linux; keeping one line ending out of the comparison
# means a diff reports content rather than which machine committed it.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF.
*.sln text eol=crlf
*.slnx text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch, never diff.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.dll binary
*.snk binary
*.nupkg binary
*.snupkg binary
