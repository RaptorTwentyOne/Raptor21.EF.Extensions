<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Raptor21.EF.Extensions.Migrations.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- The SQL Server provider, in the test project only. HasDifferences takes an IRelationalModel and
       IMigrator.GenerateScript is what `dotnet ef migrations script` calls, so both fixes can only be
       tested against a real provider; hand-rolling a fake IRelationalModel would mean standing in for
       everything the base differ walks. Neither call opens a connection, so the tests stay offline. The
       version matches the Relational reference in the shipping package, which still depends on Relational
       alone — nothing here widens what a consumer installs. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.Migrations\Raptor21.EF.Extensions.Migrations.csproj" />
  </ItemGroup>

</Project>
