<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <RootNamespace>Raptor21.EF.Extensions.StoredProcedures.Generator</RootNamespace>
    <AssemblyName>Raptor21.EF.Extensions.StoredProcedures.Generator</AssemblyName>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <Description>Roslyn source generator for Raptor21.EF.Extensions.StoredProcedures.</Description>
    <!-- Not its own package. It is packed into Raptor21.EF.Extensions.StoredProcedures under
         analyzers/dotnet/cs. Packing it alone produced NU5017 (no content, no dependencies) and would
         let someone install a generator without the runtime its output compiles against. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- NOT a dependency version, and not to be bumped with the rest of the tree: this line is the
       oldest compiler that can load the shipped analyzer. A compiler older than the Roslyn this
       is built against refuses the assembly with CS9057 - a WARNING - and then every contract, row
       materialiser and registry the generator writes is simply absent, so the consumer's build fails
       on missing types and partial methods with no implementation, in their own files, mentioning no
       analyzer. Reproduced: built against 5.9.0 the sample fails on SDK 10.0.100 with CS9057 plus a
       dozen CS0234/CS8795; against 5.0.0 the same SDK builds clean. 5.0.0 is the Roslyn in the first
       .NET 10 SDK, and the library targets net10.0 alone, so this floor covers every SDK that can
       build a consumer at all. Raise it only to reach an API the generator actually needs, and only
       by deciding which consumers to drop. Generator.Tests tracks the newest Roslyn on purpose -
       it is not shipped - which also means the test suite cannot notice a regression here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Every type in this project is internal, including ProcedureHeaderParser and the four models it
       returns. The parser is a pure function over a string - no Roslyn, no driver, no compilation - so
       it is the one part of this generator that can be tested for what it actually is rather than
       through the emitted text, and that is worth an assembly-visibility line. The same precedent, and
       the same reasoning, as the runtime library's single InternalsVisibleTo. Compile-time only: the
       generator ships as an analyzer, so this costs a consumer nothing. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Raptor21.EF.Extensions.StoredProcedures.Generator.Tests" />
  </ItemGroup>

</Project>
