<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Raptor21.EF.Extensions.Migrations</RootNamespace>
    <AssemblyName>Raptor21.EF.Extensions.Migrations</AssemblyName>
    <!-- EF1001: subclassing MigrationsModelDiffer means forwarding internal-flagged constructor
         dependencies. That coupling is exactly why this package tracks one EF major version instead
         of multi-targeting: an internal signature change between majors is a compile break, not a
         runtime surprise, and one TFM per EF major keeps it that way. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <IsPackable>true</IsPackable>
    <PackageId>Raptor21.EF.Extensions.Migrations</PackageId>
    <Description>Folds code-first SQL Server database objects into EF Core migrations: stored procedures as CREATE OR ALTER / DROP operations, partition functions and schemes, tables created on a partition scheme, clustered columnstore indexes, and full-text catalogs and indexes — all declared on the model, carried by the snapshot and diffed by a custom IMigrationsModelDiffer, so they travel in the same migration as the table changes. Targets EF Core 10.</Description>
    <PackageTags>efcore;migrations;sqlserver;stored-procedure;partitioning;columnstore;full-text;code-first;schema</PackageTags>
  </PropertyGroup>

  <!-- The SQL Server provider rather than Relational alone, for one base class:
       CodeFirstDatabaseObjectsMigrationsSqlGenerator extends SqlServerMigrationsSqlGenerator to write
       CREATE TABLE ... ON [scheme]([column]), and there is no provider-neutral seam for a table's physical
       placement. Every object this package emits — CREATE OR ALTER PROCEDURE, partition functions and
       schemes, columnstore indexes — is SQL Server T-SQL already, so the dependency states what was
       always true rather than narrowing anything. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
  </ItemGroup>

  <!-- The runtime package, for one type: SqlBatch. This side used to have a GO reader of its own - a
       regex that rejected any script with a matching line, including a GO written inside a literal or a
       block comment, which is content. A script that one reader accepts and another refuses fails at
       deployment on a file that built cleanly, so the rule lives in one place and this project calls it.
       The dependency direction is the honest one: the EF integration sits on top of the EF-free runtime,
       never the reverse. -->
  <ItemGroup>
    <ProjectReference Include="..\Raptor21.EF.Extensions.StoredProcedures\Raptor21.EF.Extensions.StoredProcedures.csproj" />
  </ItemGroup>

</Project>
