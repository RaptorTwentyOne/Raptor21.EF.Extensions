<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 (missing XML comment) is suppressed the way the sibling repos suppress it, so the build is
         quiet. It is not a statement that the docs are unnecessary: the contract and execution surfaces
         still owe roughly twenty member comments, which is what a consumer sees in IntelliSense. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <Authors>RaptorTwentyOne</Authors>
    <Product>Raptor21.EF.Extensions</Product>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- The development version, used by a local `dotnet pack`. A release takes its version from the git
         tag instead (see .github/workflows/release.yml), so a published package always traces back to
         exactly one commit. -->
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview.1</VersionSuffix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/RaptorTwentyOne/Raptor21.EF.Extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RaptorTwentyOne/Raptor21.EF.Extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
