<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Raptor21.EF.Extensions.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- These two lines are what a NuGet consumer gets from the single
       <PackageReference Include="Raptor21.EF.Extensions.StoredProcedures" /> - the runtime assembly and
       the generator as an analyzer. Spelled out here because the sample builds from source. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.StoredProcedures\Raptor21.EF.Extensions.StoredProcedures.csproj" />
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.StoredProcedures.Generator\Raptor21.EF.Extensions.StoredProcedures.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.Migrations\Raptor21.EF.Extensions.Migrations.csproj" />
  </ItemGroup>

  <!-- Procedure bodies are the source of truth and travel with the assembly. The EF model reads the same
       resources at model-building time, so the migration carries the procedure the generator compiled against. -->
  <ItemGroup>
    <EmbeddedResource Include="DbScripts\*.sql" />
  </ItemGroup>

  <!-- The third thing a NuGet consumer gets for free, alongside the two ProjectReferences above: the
       package's buildTransitive targets, which hand the same *.sql files to the compiler a second time
       as AdditionalFiles so the generator can read the parameter declarations out of the procedure
       headers. EmbeddedResource ships the bytes at run time; AdditionalFiles shows them to the
       generator at compile time. Neither channel can do the other's job - see the targets file for why.

       A ProjectReference does not import a referenced project's buildTransitive targets, so the sample
       has to do it by hand. Imported rather than copied: this is the repo's only executable check on
       the shipped file, and a copy would drift from it. It must sit BELOW the EmbeddedResource
       ItemGroup, because an Import in a project body is evaluated in place and reads
       @(EmbeddedResource) as it stands at that point. -->
  <Import Project="..\..\src\Raptor21.EF.Extensions.StoredProcedures\buildTransitive\Raptor21.EF.Extensions.StoredProcedures.targets" />

</Project>
