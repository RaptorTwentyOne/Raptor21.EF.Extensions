<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Raptor21.EF.Extensions.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- These two lines are what a NuGet consumer gets from the single
       <PackageReference Include="Raptor21.EF.Extensions.StoredProcedures" /> - the runtime assembly and
       the generator as an analyzer. Spelled out here because the sample builds from source. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.StoredProcedures\Raptor21.EF.Extensions.StoredProcedures.csproj" />
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.StoredProcedures.Generator\Raptor21.EF.Extensions.StoredProcedures.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Raptor21.EF.Extensions.Migrations\Raptor21.EF.Extensions.Migrations.csproj" />
  </ItemGroup>

  <!-- Procedure bodies are the source of truth and travel with the assembly. The EF model reads the same
       resources at model-building time, so one file feeds both the migration and the startup applier. -->
  <ItemGroup>
    <EmbeddedResource Include="DbScripts\*.sql" />
  </ItemGroup>

</Project>
